#!/usr/bin/env python3
"""Launch the baatsun tray icon (see src/baatsun_tray.py)."""
import os
import sys

INSTALLED_SCRIPT = "/opt/baatsun/src/baatsun_tray.py"
HERE = os.path.dirname(os.path.abspath(__file__))
CHECKOUT_SCRIPT = os.path.join(HERE, "..", "src", "baatsun_tray.py")

TRAY_SCRIPT = INSTALLED_SCRIPT if os.path.exists(INSTALLED_SCRIPT) else CHECKOUT_SCRIPT

os.execv(sys.executable, [sys.executable, TRAY_SCRIPT] + sys.argv[1:])
