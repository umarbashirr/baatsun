#!/usr/bin/env python3
"""Launch the Baatsun application window (see electron/).

The window is an Electron app; the daemon, the pill and the tray are not. The
pill in particular cannot be — it needs wlr-layer-shell to sit above fullscreen
windows without taking focus, and Chromium has no way to ask for that. So this
launches one process and leaves the rest of the install alone.

Two layouts are supported, the same pair every other script here handles:
an installed tree under /opt/baatsun, and a git checkout being run in place.
"""
import os
import shutil
import subprocess
import sys

INSTALLED_APP = "/opt/baatsun/electron"
HERE = os.path.dirname(os.path.abspath(__file__))
CHECKOUT_APP = os.path.normpath(os.path.join(HERE, "..", "electron"))

APP_DIR = INSTALLED_APP if os.path.isdir(INSTALLED_APP) else CHECKOUT_APP

# Set on the window so the .desktop file's StartupWMClass matches and the
# shell groups the window under Baatsun rather than under "Electron".
WM_CLASS = "baatsun"


def find_electron():
    """The bundled electron binary, or whatever is on PATH.

    Bundled first: a system electron is whatever version the distro happened to
    package, and the app is built against the one in node_modules.
    """
    bundled = os.path.join(APP_DIR, "node_modules", "electron", "dist", "electron")
    if os.path.exists(bundled):
        return bundled
    return shutil.which("electron")


def fail(message):
    """Report a launch failure where it can be seen.

    Launched from the app menu or the tray there is no terminal, so stderr
    alone meant clicking the icon just did nothing. A desktop notification
    says why.
    """
    print(f"baatsun-gui: {message}", file=sys.stderr)
    notify = shutil.which("notify-send")
    if notify:
        try:
            subprocess.run([notify, "--app-name=Baatsun", "-i", "dialog-error",
                            "Baatsun could not open", message],
                           check=False, timeout=5)
        except (OSError, subprocess.TimeoutExpired):
            pass
    return 1


SANDBOX_PROBE_SECONDS = 6
SANDBOX_MARKER = os.path.join(
    os.environ.get("XDG_CACHE_HOME") or os.path.expanduser("~/.cache"),
    "baatsun", "sandbox-unavailable")


def _electron_id(electron):
    """Which Electron build a sandbox verdict applies to."""
    real = os.path.realpath(electron)
    try:
        return f"{real} {int(os.stat(real).st_mtime)}"
    except OSError:
        return real


def sandbox_known_broken(electron):
    try:
        with open(SANDBOX_MARKER) as f:
            return f.read().strip() == _electron_id(electron)
    except OSError:
        return False


def remember_sandbox_broken(electron):
    # Keyed by binary and mtime, so an upgrade (or a newly installed AppArmor
    # profile, via `rm ~/.cache/baatsun/sandbox-unavailable`) tries again.
    try:
        os.makedirs(os.path.dirname(SANDBOX_MARKER), exist_ok=True)
        with open(SANDBOX_MARKER, "w") as f:
            f.write(_electron_id(electron) + "\n")
    except OSError:
        pass


def unsandboxed(electron, argv):
    """Replace this process with the window, Chromium sandbox off."""
    os.execv(electron, argv[:1] + ["--no-sandbox"] + argv[1:])


def main():
    if not os.path.isdir(APP_DIR):
        return fail(f"no application window found at {APP_DIR}")

    if not os.path.exists(os.path.join(APP_DIR, "dist", "index.html")):
        return fail("the window has not been built yet. Run:\n"
                    f"  cd {APP_DIR} && npm install && npm run build")

    electron = find_electron()
    if not electron:
        return fail(f"electron is not installed. Run:\n  cd {APP_DIR} && npm install")

    argv = [electron, APP_DIR, f"--class={WM_CLASS}"]

    # Wayland-native where the session is Wayland, XWayland otherwise. Left to
    # Electron rather than pinned, because pinning it breaks the other one.
    argv.append("--ozone-platform-hint=auto")
    argv += sys.argv[1:]

    # Set, not setdefault. This is the installed launcher, so it should never
    # be the thing that loads the dev server — and setdefault let a stray
    # BAATSUN_DEV=1 already in the environment decide that for it.
    os.environ["BAATSUN_DEV"] = "0"

    if os.environ.get("BAATSUN_NO_SANDBOX") == "1" or sandbox_known_broken(electron):
        unsandboxed(electron, argv)

    # Sandboxed first. Where Chromium can't set up its sandbox — Ubuntu 24.04+
    # without the AppArmor profile the .deb installs, a from-source checkout,
    # a container — Electron aborts within a second, before any window
    # exists, and a .desktop launch has nowhere to print that. So start it,
    # and if it dies early with an error, remember that for this Electron
    # build and come back up unsandboxed: a window that opens beats a secure
    # one that never does. This window loads no remote content (see the CSP),
    # and API keys never reach its renderer, which is what makes the fallback
    # acceptable.
    try:
        proc = subprocess.Popen(argv)
    except OSError as exc:
        return fail(f"could not start electron: {exc}")
    try:
        code = proc.wait(timeout=SANDBOX_PROBE_SECONDS)
    except subprocess.TimeoutExpired:
        # Up and running. Leave it; nothing waits on this launcher.
        return 0
    except KeyboardInterrupt:
        proc.terminate()
        return 130
    if code == 0:
        # Normal quick exit, e.g. another window was already open and this
        # launch just raised it (Electron's single-instance lock).
        return 0
    print(f"baatsun-gui: sandboxed start failed (exit {code}); "
          "starting without the sandbox", file=sys.stderr)
    remember_sandbox_broken(electron)
    unsandboxed(electron, argv)


if __name__ == "__main__":
    sys.exit(main())
