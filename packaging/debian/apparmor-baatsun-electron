# Lets the Baatsun window's Electron binary create the unprivileged user
# namespaces Chromium's sandbox is built on. Ubuntu 24.04+ forbids that by
# default (kernel.apparmor_restrict_unprivileged_userns=1) unless a profile
# like this one grants it — Ubuntu ships the same kind of profile for Chrome,
# Firefox and other Electron apps. Without it the window would have to run
# with --no-sandbox.
#
# Installed to /etc/apparmor.d by postinst only where AppArmor ABI 4.0 exists;
# older releases have no such restriction and need nothing.
abi <abi/4.0>,
include <tunables/global>

profile baatsun-electron /opt/baatsun/electron/node_modules/electron/dist/electron flags=(unconfined) {
  userns,

  include if exists <local/baatsun-electron>
}
