#!/bin/sh
# postinst for baatsun: builds the venv the daemon runs from, activates the
# ydotool udev rule, and gets the invoking user into the 'input' group.
set -e

VENV=/opt/baatsun/venv
REQUIREMENTS=/opt/baatsun/requirements.txt

case "$1" in
    configure)
        # Rebuild after a Python minor upgrade (3.12 -> 3.13): the venv's
        # python3 symlink still resolves, but it now looks in a site-packages
        # directory that is empty, and the daemon dies on "No module evdev".
        SYS_PY="$(python3 -c 'import sys; print("%d.%d" % sys.version_info[:2])')"
        if [ -x "$VENV/bin/python3" ]; then
            VENV_PY="$("$VENV/bin/python3" -c 'import sys; print("%d.%d" % sys.version_info[:2])' 2>/dev/null || true)"
            if [ "$VENV_PY" != "$SYS_PY" ]; then
                echo "baatsun: Python changed (${VENV_PY:-unknown} -> $SYS_PY); rebuilding the virtualenv ..."
                rm -rf "$VENV"
            fi
        fi
        if [ ! -x "$VENV/bin/python3" ]; then
            echo "baatsun: creating virtualenv at $VENV ..."
            python3 -m venv "$VENV"
        fi

        # Pinned, from requirements.txt, rather than `--upgrade faster-whisper
        # numpy evdev`. This runs as root with network access, so "whatever is
        # newest on PyPI right now" decided what executed as root and made two
        # installs of the same .deb differ. See the header of that file.
        #
        # The pip self-upgrade that used to run here is gone for the same
        # reason: it was one more unpinned root install, and the pip shipped
        # with python3-venv already installs these wheels.
        echo "baatsun: installing the transcription dependencies into the virtualenv (needs network access)..."
        if [ ! -f "$REQUIREMENTS" ]; then
            echo "baatsun: $REQUIREMENTS is missing; cannot build the virtualenv." >&2
            exit 1
        fi
        # evdev ships sdist-only, so this compiles a C extension (python3-dev
        # is a package Depends for that). Keep pip's output visible: the
        # wheels are large, and --quiet made a missing Python.h look like apt
        # had hung and then failed with no cause.
        #
        # --no-build-isolation: otherwise pip fetches the *latest* setuptools
        # from PyPI into a throwaway build env to compile evdev, and runs it as
        # root — the unpinned exposure requirements.txt exists to remove. The
        # pinned setuptools goes in first and builds it instead.
        SETUPTOOLS_PIN="$(grep -E '^setuptools==' "$REQUIREMENTS" || true)"
        if [ -n "$SETUPTOOLS_PIN" ]; then
            "$VENV/bin/pip" install --require-virtualenv "$SETUPTOOLS_PIN"
        fi
        if ! "$VENV/bin/pip" install --require-virtualenv --no-build-isolation -r "$REQUIREMENTS"; then
            echo "baatsun: failed to install Python dependencies into $VENV." >&2
            echo "         evdev has to be compiled; install python3-dev and retry:" >&2
            echo "           sudo apt install -y python3-dev && sudo dpkg --configure -a" >&2
            exit 1
        fi

        chmod -R a+rX /opt/baatsun

        # The window always runs with --no-sandbox (see bin/baatsun-gui), so
        # Chromium's helper must NOT be setuid root: that would be a root
        # binary from npm that nothing ever uses. Older releases set it; undo.
        SANDBOX=/opt/baatsun/electron/node_modules/electron/dist/chrome-sandbox
        if [ -f "$SANDBOX" ]; then
            chmod 0755 "$SANDBOX"
        fi

        udevadm control --reload-rules >/dev/null 2>&1 || true
        udevadm trigger --name-match=uinput >/dev/null 2>&1 || true
        update-desktop-database -q /usr/share/applications >/dev/null 2>&1 || true

        TARGET_USER="${SUDO_USER:-}"
        if [ -z "$TARGET_USER" ] && [ -n "${PKEXEC_UID:-}" ]; then
            TARGET_USER="$(getent passwd "$PKEXEC_UID" | cut -d: -f1)"
        fi
        if [ -n "$TARGET_USER" ] && ! id "$TARGET_USER" >/dev/null 2>&1; then
            TARGET_USER=""
        fi

        NEED_RELOGIN=""
        if [ -n "$TARGET_USER" ]; then
            if ! id -nG "$TARGET_USER" 2>/dev/null | tr ' ' '\n' | grep -qx input; then
                usermod -aG input "$TARGET_USER"
                echo "baatsun: added '$TARGET_USER' to the 'input' group."
                NEED_RELOGIN=1
            fi
        fi

        echo ""
        echo "Baatsun installed. To finish setup:"
        echo ""
        STEP=1
        if [ -z "$TARGET_USER" ]; then
            echo "  $STEP. Add yourself to the 'input' group (needed for ydotool):"
            echo "       sudo usermod -aG input \"\$USER\""
            echo "     Then log out and back in."
            STEP=$((STEP + 1))
        elif [ -n "$NEED_RELOGIN" ]; then
            echo "  $STEP. Log out and back in (so the new 'input' group membership takes effect)."
            STEP=$((STEP + 1))
        fi
        echo "  $STEP. Run: systemctl --user enable --now baatsun"
        STEP=$((STEP + 1))
        echo "  $STEP. Open the app from your launcher (search 'Baatsun'), the tray icon,"
        echo "     or right-click the pill. Dictation itself needs no window open."
        echo ""
        echo "The pill (the bottom-centre recording indicator) autostarts on next"
        echo "login; run 'baatsun-pill' now to bring it up immediately. On GNOME"
        echo "this just enables the bundled Shell extension — no window to launch."
        echo "Settings, API keys and history live in the Baatsun window — search"
        echo "the app launcher for 'Baatsun', or run 'baatsun-gui'. Full docs:"
        echo "https://github.com/umarbashirr/baatsun#readme"
        echo ""
        ;;
esac

exit 0
