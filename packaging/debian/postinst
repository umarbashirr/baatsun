#!/bin/sh
# postinst for baatsun: builds the venv the daemon runs from, activates the
# ydotool udev rule, and gets the invoking user into the 'input' group.
set -e

VENV=/opt/baatsun/venv
REQUIREMENTS=/opt/baatsun/requirements.txt

case "$1" in
    configure)
        if [ ! -x "$VENV/bin/python3" ]; then
            echo "baatsun: creating virtualenv at $VENV ..."
            python3 -m venv "$VENV"
        fi

        # Pinned, from requirements.txt, rather than `--upgrade faster-whisper
        # numpy evdev`. This runs as root with network access, so "whatever is
        # newest on PyPI right now" decided what executed as root and made two
        # installs of the same .deb differ. See the header of that file.
        #
        # The pip self-upgrade that used to run here is gone for the same
        # reason: it was one more unpinned root install, and the pip shipped
        # with python3-venv already installs these wheels.
        echo "baatsun: installing the transcription dependencies into the virtualenv (needs network access)..."
        if [ ! -f "$REQUIREMENTS" ]; then
            echo "baatsun: $REQUIREMENTS is missing; cannot build the virtualenv." >&2
            exit 1
        fi
        "$VENV/bin/pip" install --quiet --require-virtualenv -r "$REQUIREMENTS"

        chmod -R a+rX /opt/baatsun

        # Chromium refuses to start unsandboxed unless told to, and its setuid
        # helper only works owned by root with the setuid bit set. Doing it here
        # is what lets baatsun-gui run the window *with* its sandbox; without
        # this the launcher falls back to --no-sandbox.
        SANDBOX=/opt/baatsun/electron/node_modules/electron/dist/chrome-sandbox
        if [ -f "$SANDBOX" ]; then
            chown root:root "$SANDBOX"
            chmod 4755 "$SANDBOX"
        fi

        udevadm control --reload-rules >/dev/null 2>&1 || true
        udevadm trigger --name-match=uinput >/dev/null 2>&1 || true

        TARGET_USER="${SUDO_USER:-}"
        if [ -z "$TARGET_USER" ] && [ -n "${PKEXEC_UID:-}" ]; then
            TARGET_USER="$(getent passwd "$PKEXEC_UID" | cut -d: -f1)"
        fi
        if [ -n "$TARGET_USER" ] && ! id "$TARGET_USER" >/dev/null 2>&1; then
            TARGET_USER=""
        fi

        NEED_RELOGIN=""
        if [ -n "$TARGET_USER" ]; then
            if ! id -nG "$TARGET_USER" 2>/dev/null | tr ' ' '\n' | grep -qx input; then
                usermod -aG input "$TARGET_USER"
                echo "baatsun: added '$TARGET_USER' to the 'input' group."
                NEED_RELOGIN=1
            fi
        fi

        echo ""
        echo "Baatsun installed. To finish setup:"
        echo ""
        STEP=1
        if [ -z "$TARGET_USER" ]; then
            echo "  $STEP. Add yourself to the 'input' group (needed for ydotool):"
            echo "       sudo usermod -aG input \"\$USER\""
            echo "     Then log out and back in."
            STEP=$((STEP + 1))
        elif [ -n "$NEED_RELOGIN" ]; then
            echo "  $STEP. Log out and back in (so the new 'input' group membership takes effect)."
            STEP=$((STEP + 1))
        fi
        echo "  $STEP. Run: systemctl --user enable --now baatsun"
        echo ""
        echo "The pill (the bottom-centre recording indicator) autostarts on next"
        echo "login; run 'baatsun-pill' now to bring it up immediately. On GNOME"
        echo "this just enables the bundled Shell extension — no window to launch."
        echo "The tray icon and history window are still available: 'baatsun-tray',"
        echo "or open the 'Baatsun' app from your launcher. Full docs:"
        echo "https://github.com/umarbashirr/baatsun#readme"
        echo ""
        ;;
esac

exit 0
