[Desktop Entry]
Type=Application
Name=Baatsun
Comment=Transcript history, recording controls, and settings for baatsun
Exec=baatsun-gui
Icon=audio-input-microphone
Terminal=false
Categories=Utility;
# Matches --class on XWayland and app.setName()/setDesktopName() on Wayland;
# without it the window docks as a generic "Electron" with the wrong icon.
StartupWMClass=baatsun
