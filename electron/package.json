{
  "name": "baatsun-desktop",
  "version": "0.1.0",
  "description": "Baatsun — the application window",
  "main": "src/main/main.js",
  "author": "Umar Bashir",
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "concurrently -k -n vite,electron -c cyan,magenta \"vite\" \"wait-on tcp:5173 && npm run electron\"",
    "build": "vite build",
    "start": "npm run build && BAATSUN_DEV=0 electron . --no-sandbox --ozone-platform-hint=auto",
    "electron": "BAATSUN_DEV=1 electron . --no-sandbox --ozone-platform-hint=auto",
    "preview": "vite preview"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^9.1.0",
    "electron": "^43.0.0",
    "tailwindcss": "^4.1.0",
    "vite": "^7.0.0",
    "wait-on": "^8.0.0"
  },
  "dependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  }
}
